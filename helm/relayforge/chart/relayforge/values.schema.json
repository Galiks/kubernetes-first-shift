{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": ["image", "api", "worker", "clientAuthSecret"],
  "additionalProperties": false,
  "properties": {
    "image": {
      "type": "object",
      "required": ["digest"],
      "properties": {
        "repository": {"type": "string", "minLength": 1},
        "digest": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"}
      }
    },
    "api": {
      "type": "object",
      "properties": {
        "replicas": {"type": "integer", "minimum": 1}
      }
    },
    "testSink": {
      "type": "object",
      "properties": {
        "enabled": {"type": "boolean"}
      }
    }
  },
  "if": {
    "properties": {"testSink": {"properties": {"enabled": {"const": true}}}}
  },
  "then": {
    "required": ["testSink"],
    "properties": {
      "testSink": {
        "required": ["verificationSecret", "controlSecret"]
      }
    }
  }
}
