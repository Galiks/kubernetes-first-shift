.uv-cache/
.helm-xdg-cache/
*.egg-info/

# Helm
.helm-charts/
chart/relayforge/*.tgz

# Локальные артефакты сборки/секреты (cluster/secret_create.sh пишет токены на диск
# в текущий каталог — поэтому игнорируем *-token.txt на любом уровне;
# kubeconfig.yaml — локальный kubeconfig для k3d, в Git не попадает)
cluster/image-digest.txt
*-token.txt
cluster/kubeconfig.yaml

# Локальные временные файлы
*.tmp